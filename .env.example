# ============================================================
# Stieve Software Company — CompanyOS
# Modelo público de variáveis de ambiente
# ============================================================
#
# Uso:
#   cp .env.example .env
#   nano .env
#
# Regras:
# - Não envie o arquivo .env ao Git.
# - Troque todas as senhas marcadas com CHANGE_ME.
# - Não use estas credenciais em produção.
# - Não adicione espaços antes ou depois do sinal "=".
#
# ============================================================

# ------------------------------------------------------------
# Identidade da plataforma
# ------------------------------------------------------------

COMPOSE_PROJECT_NAME=ssc
SSC_ENVIRONMENT=development
SSC_VERSION=0.2.0
SSC_TIMEZONE=America/Sao_Paulo

# Nome do host ou endereço da VM.
SSC_HOST=localhost

# Diretório base usado por scripts.
SSC_ROOT_DIR=.

# ------------------------------------------------------------
# Política geral
# ------------------------------------------------------------

SSC_LOG_LEVEL=INFO
SSC_LOG_FORMAT=json
SSC_DEBUG=false

# Limites padrão dos logs do Docker.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_IMAGE=postgres:18.4
POSTGRES_DB=companyos
POSTGRES_USER=companyos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Credenciais de runtime com privilégio mínimo.
POSTGRES_APP_USER=companyos_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD

# Credenciais exclusivas de observabilidade.
POSTGRES_MONITOR_USER=companyos_monitor
POSTGRES_MONITOR_PASSWORD=CHANGE_ME_POSTGRES_MONITOR_PASSWORD

POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------

RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine
RABBITMQ_DEFAULT_USER=companyos
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=development

RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_AMQP_CONTAINER_PORT=5672

RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_MANAGEMENT_CONTAINER_PORT=15672

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_IMAGE=redis:8.8.1-alpine
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379

REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction

# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=companyos
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

MINIO_API_HOST_PORT=9000
MINIO_API_CONTAINER_PORT=9000

MINIO_CONSOLE_HOST_PORT=9001
MINIO_CONSOLE_CONTAINER_PORT=9001

MINIO_DEFAULT_BUCKETS=companyos-references,companyos-artifacts,companyos-exports,companyos-backups

# ------------------------------------------------------------
# Ollama / provedor de IA
# ------------------------------------------------------------

AI_PROVIDER=ollama

# Valores aceitos inicialmente: internal ou external.
# external: Ollama em outro host, como o Windows com a RX 7600.
OLLAMA_DEPLOYMENT_MODE=external

# Usada apenas quando o perfil Docker "ai" for ativado.
OLLAMA_IMAGE=ollama/ollama:0.32.3
OLLAMA_HOST_PORT=11434
OLLAMA_CONTAINER_PORT=11434

# No .env privado, substitua pelo endereço real.
OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:3b
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_VERIFY_MODEL=true

# Refere-se ao container Ollama opcional, não ao host externo.
SSC_ENABLE_GPU=false

# ------------------------------------------------------------
# Prometheus
# ------------------------------------------------------------

PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_CONTAINER_PORT=9090

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------

GRAFANA_IMAGE=grafana/grafana:12.3.9
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

GRAFANA_HOST_PORT=3000
GRAFANA_CONTAINER_PORT=3000

GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_LOG_LEVEL=info

# ------------------------------------------------------------
# Loki
# ------------------------------------------------------------

LOKI_IMAGE=grafana/loki:3.7.4
LOKI_HOST_PORT=3100
LOKI_CONTAINER_PORT=3100

# ------------------------------------------------------------
# Aplicação futura — CompanyOS API
# ------------------------------------------------------------

COMPANYOS_API_HOST_PORT=8000
COMPANYOS_API_CONTAINER_PORT=8000
COMPANYOS_API_WORKERS=1

DATABASE_URL=postgresql+psycopg://companyos_app:CHANGE_ME_POSTGRES_APP_PASSWORD@postgres:5432/companyos
RABBITMQ_URL=amqp://companyos:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/development
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
MINIO_ENDPOINT=minio:9000

# ------------------------------------------------------------
# Autenticação futura
# ------------------------------------------------------------

JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------
# Criptografia e segurança
# ------------------------------------------------------------

APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY
PASSWORD_HASH_ALGORITHM=argon2

COOKIE_SECURE=false

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Workspaces e armazenamento local
# ------------------------------------------------------------

SSC_WORKSPACES_DIR=./data/workspaces
SSC_ARTIFACTS_DIR=./data/artifacts
SSC_TEMPORARY_DIR=./data/temporary
SSC_BACKUPS_DIR=./infrastructure/backups

WORKSPACE_DEFAULT_QUOTA_MB=2048
ARTIFACT_MAX_SIZE_MB=512
REFERENCE_MAX_SIZE_MB=100

# ------------------------------------------------------------
# Backup
# ------------------------------------------------------------

BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESSION=gzip
BACKUP_VERIFY_CHECKSUM=true

# ------------------------------------------------------------
# Health checks
# ------------------------------------------------------------

HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5

# ------------------------------------------------------------
# Configurações reservadas para ambientes futuros
# ------------------------------------------------------------

SSC_PUBLIC_URL=http://localhost
SSC_API_URL=http://localhost:8000
SSC_MISSION_CONTROL_URL=http://localhost:3000

TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# ------------------------------------------------------------
# Plugins futuros
# ------------------------------------------------------------

PLUGIN_RUNTIME_ENABLED=false
PLUGIN_NETWORK_DEFAULT=NONE
PLUGIN_DEFAULT_CPU_LIMIT=0.50
PLUGIN_DEFAULT_MEMORY_LIMIT_MB=256

# ------------------------------------------------------------
# Agent Runtime futuro
# ------------------------------------------------------------

AGENT_RUNTIME_ENABLED=false
AGENT_DEFAULT_TIMEOUT_SECONDS=900
AGENT_DEFAULT_CPU_LIMIT=1.00
AGENT_DEFAULT_MEMORY_LIMIT_MB=2048
AGENT_MAX_CONCURRENT_EXECUTIONS=2

# ------------------------------------------------------------
# Workflow Engine futuro
# ------------------------------------------------------------

WORKFLOW_ENGINE_ENABLED=false
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=3600
WORKFLOW_MAX_RETRY_ATTEMPTS=5

# ------------------------------------------------------------
# Feature flags iniciais
# ------------------------------------------------------------

FEATURE_MISSION_CONTROL=false
FEATURE_AGENT_RUNTIME=false
FEATURE_WORKFLOW_ENGINE=false
FEATURE_PLUGIN_SYSTEM=false
FEATURE_SEMANTIC_SEARCH=false
